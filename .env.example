# =========================================
# LOKAL (MySQL di komputer sendiri)
# =========================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=absensi_karyawan
DB_SSL=false

# Wajib diganti di production. Generate via:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Base URL untuk fetch API dari frontend.
# Kosong = relative (sama domain, mode web).
# Buat APK Capacitor: isi pakai URL Vercel kamu, contoh:
#   NUXT_PUBLIC_API_BASE=https://absensi-karyawan.vercel.app
NUXT_PUBLIC_API_BASE=

# =========================================
# TIDB CLOUD (production di Vercel)
# =========================================
# Ambil dari: TiDB Cloud Console -> Cluster -> Connect -> General
# Contoh:
# DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_USER=xxxxxxx.root
# DB_PASSWORD=xxxxxxxxxxxx
# DB_NAME=absensi_karyawan
# DB_SSL=true
