    "exceljs": "^4.4.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.4",
    "nuxt": "^3.14.1592",
    "pdfkit": "^0.15.0",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
