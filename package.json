{
  "name": "absensi-karyawan",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "concurrently -n nuxt,tunnel -c cyan,magenta \"npm:dev:nuxt\" \"npm:dev:tunnel\"",
    "dev:nuxt": "nuxt dev --host 0.0.0.0",
    "dev:tunnel": "cloudflared tunnel --url http://localhost:3000 --protocol http2 --edge-ip-version 4",
    "dev:local": "nuxt dev --host 0.0.0.0",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:setup": "node scripts/setup-db.mjs",
    "build:capacitor": "nuxt generate",
    "cap:add-android": "cap add android",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.3",
